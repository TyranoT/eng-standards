        <mxCell id="legenda" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&amp;#9472;&amp;#9472;&amp;#9654; chamada síncrona&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;- - -&amp;gt; retorno&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&amp;#9472;&amp;#9472;&amp;gt; mensagem assíncrona&lt;br&gt;Barra branca = participante ativo&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#9673A6&quot;&gt;&amp;#9632;&lt;/font&gt; sistema externo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
